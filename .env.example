# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Flask
FLASK_ENV=development

# Set to a long, random string in production.
# If unset, a random key is generated at startup (sessions reset on restart).
SECRET_KEY=replace-me-with-a-long-random-string

# Optional overrides
# DATABASE_PATH=instance/interviewiq.db
# SESSION_IDLE_TIMEOUT_MINUTES=30
# SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Google Gemini API (Stage 2: integration foundation)
# ---------------------------------------------------------------------------
# Obtain a key at https://aistudio.google.com/apikey and paste it here.
# The app boots and works without it; AI-powered features stay disabled until
# it is set. The key is read server-side only and is never exposed to the
# browser, JavaScript, version control, or the database.
GEMINI_API_KEY=

# Model is configurable; defaults to Gemini 2.5 Flash as per the blueprint.
GEMINI_MODEL=gemini-2.5-flash

# Request timeout in seconds and number of retries for malformed responses.
# GEMINI_TIMEOUT_SECONDS=30
# GEMINI_MAX_RETRIES=1

# ---------------------------------------------------------------------------
# Stage 6: uploads, rate limiting, deployment hardening
# ---------------------------------------------------------------------------
# Resume PDFs are stored OUTSIDE the web root (default: instance/resumes).
# RESUME_UPLOAD_DIR=
# Max accepted resume size in bytes (blueprint Section J: ~5MB).
# RESUME_MAX_BYTES=5242880
# Global request-body cap in bytes (rejects oversized uploads early).
# MAX_CONTENT_LENGTH_BYTES=8388608

# Rate limits (Section J). In-process counters: they hold exactly for a
# SINGLE-instance deployment (this project's target shape) and reset when
# the process restarts; multiple workers would each count separately.
# RATELIMIT_AUTH_LIMIT=5      # auth POSTs per window per IP
# RATELIMIT_AUTH_WINDOW=60
# RATELIMIT_GEMINI_LIMIT=20   # AI-backed requests per window per user
# RATELIMIT_GEMINI_WINDOW=60

# Production deployment checklist (Section K.12):
#   FLASK_ENV=production            -> DEBUG off
#   SECRET_KEY set to a long random value (sessions survive restarts)
#   SESSION_COOKIE_SECURE=true      -> requires HTTPS
#   serve via an HTTPS reverse proxy; never expose the Flask dev server
#   DATABASE_PATH / RESUME_UPLOAD_DIR on persistent storage, backed up
